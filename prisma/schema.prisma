// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "bun"
}

datasource db {
  provider = "mysql"
}

model Funds {
  id      Int  @unique @default(autoincrement())
  balance Int  @default(0)
  clanId  Int  @unique
  clans   Clan @relation(fields: [clanId], references: [id])
}

model Clan {
  id         Int      @unique @default(autoincrement())
  title      String
  ownerId    String   @unique
  experience Int      @default(0)
  chatLink   String?
  createdAt  DateTime @default(now())
  users      User[]
  background String   @default("default")
  frame      String   @default("orange")
  funds      Funds?
  bet        Int      @default(0)
}

model Couple {
  id           Int    @id @default(autoincrement())
  createdAt    BigInt
  background   String @default("default")
  frame        String @default("orange")
  canKissAt    BigInt @default(0)
  lastKissAt   BigInt @default(0)
  kissStreak   Int    @default(0)
  experience   Int    @default(0)
  kissesAmount Int    @default(0)
  lastStreakAt BigInt @default(0)
  users        User[]
}

model Upgrade {
  id        Int         @id @default(autoincrement())
  upgradeAt BigInt      @default(0)
  type      UpgradeType @default(NOTHING)
  userId    String      @unique
  user      User        @relation(fields: [userId], references: [id])
}

model Schedule {
  id         Int    @id @default(autoincrement())
  canWorkAt  BigInt @default(0)
  canDailyAt BigInt @default(0)
  canRobAt   BigInt @default(0)
  canDuelAt  BigInt @default(0)
  canHackAt  BigInt @default(0)
  canRepAt   BigInt @default(0)
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id])
}

model ProductsOnUser {
  id        Int    @id @default(autoincrement())
  productId Int
  userId    String
  user      User   @relation(fields: [userId], references: [id])
}

model Card {
  id       Int    @id @default(autoincrement())
  number   String
  date     String
  initials String
  balance  Float  @default(0)
  cash     Float  @default(0)
  color    String @default("gradient")
  ownerId  String @unique
  owner    User   @relation(fields: [ownerId], references: [id])
}

model Stats {
  id         Int    @id @default(autoincrement())
  experience Int    @default(0)
  reputation Int    @default(0)
  messages   Int    @default(0)
  robs       Int    @default(0)
  duels      Int    @default(0)
  deck       Int    @default(1)
  ice        Int    @default(1)
  prestige   Int    @default(0)
  userId     String @unique
  perk       Perk?
  user       User   @relation(fields: [userId], references: [id])
}

model User {
  id         String           @id @unique
  background String           @default("default")
  frame      String           @default("orange")
  work       Int?
  card       Card?
  stats      Stats?
  schedule   Schedule?
  products   ProductsOnUser[]
  upgrade    Upgrade?
  coupleId   Int?
  clanId     Int?
  couple     Couple?          @relation(fields: [coupleId], references: [id])
  clan       Clan?            @relation(fields: [clanId], references: [id])
}

enum UpgradeType {
  STRENGTH
  DECK
  ICE
  PRESTIGE
  NOTHING
}

enum Perk {
  DECK
  ICE
}
